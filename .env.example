PORT=3000

# PostgreSQL (usuário dono do banco: roda migrations e consultas de autenticação/plataforma)
DATABASE_URL=postgres://odonto:odonto@127.0.0.1:5432/odonto
# DATABASE_SSL=true            (bancos gerenciados que exigem SSL)
# DB_POOL_MAX=10

# Segredos de JWT: use valores longos e DIFERENTES entre si (o token da plataforma nunca vale como token de clínica)
JWT_SECRET=troque-por-um-segredo-longo
JWT_SECRET_PLATFORM=troque-por-outro-segredo-longo
# ACCESS_TOKEN_TTL=15m         (JWT de acesso)
# REFRESH_TOKEN_DAYS=30
# PLATFORM_TOKEN_TTL=12h
# BCRYPT_ROUNDS=10

# Fuso usado para "hoje", vencimentos e inadimplência (padrão: horário de Brasília)
# TIMEZONE=America/Sao_Paulo
# Swagger em /docs e /openapi.json (use false em produção se não quiser expor)
# DOCS_ENABLED=true

# URL do app web: usada nos links dos e-mails (/verificar-email e /redefinir-senha)
WEB_URL=http://localhost:5173
# Origens permitidas no CORS, separadas por vírgula. Sem isto, qualquer origem (o acesso é por token, não por cookie).
# CORS_ORIGINS=https://app.seudominio.com.br

# E-mail (verificação de e-mail e troca de senha) — SMTP da Hostinger, o mesmo dos outros projetos.
# Sem SMTP configurado, em desenvolvimento o e-mail é só impresso no console; em produção o envio falha.
SMTP_HOST=smtp.hostinger.com
SMTP_USER=contato@seudominio.com.br
SMTP_PASSWORD=
# SMTP_PORT=465
# SMTP_FROM_NAME=OdontoApp
# SMTP_FROM=                   (padrão: o próprio SMTP_USER; a Hostinger só aceita remetente igual ao da conta)
# EMAIL_VERIFICATION_HOURS=24
# PASSWORD_RESET_MINUTES=60
# TOKEN_RESEND_COOLDOWN_SECONDS=60

# Limite de requisições por IP — todos opcionais (padrões no código)
# RATE_LIMIT_ENABLED=true      (false desliga tudo)
# RATE_LIMIT_GLOBAL_MAX=1000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_PASSWORD_MAX=10
# Atrás de proxy (Railway): saltos de proxy confiáveis. Em produção o padrão já é 1.
# TRUST_PROXY=1

# Só para os testes (opcional): usar um PostgreSQL seu em vez do embutido. O nome do banco PRECISA terminar com _test.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/odonto_test

# Imagens e radiografias (Cloudinary). Sem as três chaves, as rotas de imagem respondem 503.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=odontoapp        # pasta raiz; use outra em desenvolvimento (ex.: odontoapp-dev)
# IMAGE_MAX_MB=10                    # limite do plano gratuito do Cloudinary (acima disso ele recusa o envio)
# IMAGE_URL_TTL_SECONDS=600          # validade do link de download

# Lembretes automáticos de consulta por e-mail (o agendador roda dentro da API)
# REMINDERS_SCHEDULER=true
# REMINDERS_INTERVAL_MINUTES=15
